{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bcc-trust/collection-showcase",
    "version": "1.0.0",
    "title": "NFT Collections",
    "category": "bcc-trust",
    "icon": "format-gallery",
    "description": "NFT collections linked to this project: floor, holders, volume, and claim status. Place on a PeepSo profile page.",
    "keywords": ["nft", "collection", "gallery", "claim", "creator", "holder"],
    "textdomain": "bcc-trust",
    "attributes": {
        "pageId": {
            "type": "number",
            "default": 0
        },
        "perPage": {
            "type": "number",
            "default": 6
        },
        "showClaim": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "render": "file:./render.php",
    "viewScript": "bcc-entity-claims",
    "style": "bcc-entity-blocks-style",
    "editorScript": "bcc-trust-blocks-editor"
}
