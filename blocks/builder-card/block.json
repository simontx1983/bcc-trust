{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bcc-trust/builder-card",
    "version": "1.0.0",
    "title": "Builder Card",
    "category": "bcc-trust",
    "icon": "id-alt",
    "description": "Profile card showing name, avatar, and trust score. Place on PeepSo profile pages or use with a specific page ID.",
    "keywords": [ "builder", "card", "profile", "trust", "badge" ],
    "textdomain": "bcc-trust",
    "attributes": {
        "pageId": {
            "type": "number",
            "default": 0
        },
        "showScore": {
            "type": "boolean",
            "default": true
        },
        "showVerifications": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "align": [ "wide", "full" ]
    },
    "render": "file:./render.php",
    "editorScript": "bcc-trust-blocks-editor"
}
