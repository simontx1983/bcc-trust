{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bcc-trust/nft-leaderboard",
    "version": "1.0.0",
    "title": "NFT Leaderboard",
    "category": "bcc-trust",
    "icon": "chart-bar",
    "description": "Top NFT collections ranked by trust score. Place on any page — works standalone as a leaderboard.",
    "keywords": ["nft", "leaderboard", "claim", "collections", "top"],
    "textdomain": "bcc-trust",
    "attributes": {
        "defaultChain": {
            "type": "string",
            "default": "evm"
        },
        "perPage": {
            "type": "number",
            "default": 20
        },
        "showClaim": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "render": "file:./render.php",
    "viewScript": "bcc-nft-leaderboard",
    "style": "bcc-entity-blocks-style",
    "editorScript": "bcc-trust-blocks-editor"
}
