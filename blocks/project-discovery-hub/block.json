{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bcc-trust/project-discovery-hub",
    "version": "1.0.0",
    "title": "Project Discovery Hub",
    "category": "bcc-trust",
    "icon": "search",
    "description": "Filterable grid of all community projects with sorting and category filters. Place on any page — works standalone as the main discovery/browse page.",
    "keywords": ["discovery", "projects", "grid", "explore", "directory"],
    "textdomain": "bcc-trust",
    "attributes": {
        "types": {
            "type": "array",
            "default": []
        },
        "verifiedOnly": {
            "type": "boolean",
            "default": false
        },
        "sortBy": {
            "type": "string",
            "default": "trust"
        },
        "limit": {
            "type": "number",
            "default": 12
        },
        "showSearch": {
            "type": "boolean",
            "default": true
        },
        "showFilters": {
            "type": "boolean",
            "default": true
        },
        "showCoverBackground": {
            "type": "boolean",
            "default": true
        },
        "showFollowers": {
            "type": "boolean",
            "default": true
        },
        "showEndorsements": {
            "type": "boolean",
            "default": true
        },
        "showVerifiedBadge": {
            "type": "boolean",
            "default": true
        },
        "showTabs": {
            "type": "boolean",
            "default": true
        },
        "needsEvalMaxVotes": {
            "type": "number",
            "default": 5
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "render": "file:./render.php",
    "editorScript": "bcc-trust-blocks-editor",
    "viewScript": "bcc-discovery-hub",
    "style": "bcc-discovery-hub-style",
    "editorStyle": "bcc-discovery-hub-editor"
}