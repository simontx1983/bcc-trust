{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bcc-trust/leaderboard",
    "version": "1.0.0",
    "title": "Trust Leaderboard",
    "category": "bcc-trust",
    "icon": "chart-bar",
    "description": "Community leaderboard. Pick a type when inserting: NFT collections, validators, or most-endorsed members. Each instance renders exactly one type — use multiple instances for multi-view pages.",
    "keywords": ["leaderboard", "rankings", "top", "nft", "validator", "endorsement"],
    "textdomain": "bcc-trust",
    "attributes": {
        "type": {
            "type": "string",
            "default": "nft"
        },
        "perPage": {
            "type": "number",
            "default": 20
        },
        "showClaim": {
            "type": "boolean",
            "default": true
        },
        "defaultChain": {
            "type": "string",
            "default": "evm"
        },
        "defaultTimeWindow": {
            "type": "string",
            "default": ""
        },
        "limit": {
            "type": "number",
            "default": 10
        },
        "context": {
            "type": "string",
            "default": ""
        },
        "showEndorserCount": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "render": "file:./render.php",
    "editorScript": "bcc-trust-blocks-editor"
}
