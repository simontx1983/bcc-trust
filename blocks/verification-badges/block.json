{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bcc-trust/verification-badges",
    "version": "1.0.0",
    "title": "Verification Badges",
    "category": "bcc-trust",
    "icon": "awards",
    "description": "Shows earned verification badges (wallet, GitHub, etc.). Place on PeepSo profile pages.",
    "keywords": ["verified", "badges", "github", "identity", "email"],
    "textdomain": "bcc-trust",
    "attributes": {
        "pageId": {
            "type": "number",
            "default": 0
        },
        "compact": {
            "type": "boolean",
            "default": false
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "render": "file:./render.php",
    "style": "bcc-verification-badges-style",
    "editorScript": "bcc-trust-blocks-editor"
}
