{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bcc-trust/validator-stats",
    "version": "1.0.0",
    "title": "Validator Stats",
    "category": "bcc-trust",
    "icon": "shield",
    "description": "Detailed validator statistics for claimed blockchain validators. Place on PeepSo profile pages or validator detail pages.",
    "keywords": ["validator", "cosmos", "staking", "claim", "operator"],
    "textdomain": "bcc-trust",
    "attributes": {
        "pageId": {
            "type": "number",
            "default": 0
        },
        "perPage": {
            "type": "number",
            "default": 4
        },
        "showClaim": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "render": "file:./render.php",
    "viewScript": "bcc-entity-claims",
    "style": "bcc-entity-blocks-style",
    "editorScript": "bcc-trust-blocks-editor"
}
