{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bcc-trust/trust-breakdown",
    "version": "1.0.0",
    "title": "Trust Score Breakdown",
    "category": "bcc-trust",
    "icon": "chart-bar",
    "description": "Detailed trust score breakdown showing individual score components. Place on PeepSo profile pages.",
    "keywords": [ "trust", "breakdown", "score", "transparency", "community" ],
    "textdomain": "bcc-trust",
    "attributes": {
        "pageId": {
            "type": "number",
            "default": 0
        }
    },
    "supports": {
        "html": false,
        "align": [ "wide", "full" ]
    },
    "render": "file:./render.php",
    "viewScript": "bcc-trust-breakdown",
    "style": "bcc-trust-breakdown-style",
    "editorScript": "bcc-trust-blocks-editor"
}
