{
    "name": "blue-collar-crypto/bcc-trust",
    "description": "Unified reputation, dispute, and on-chain signal plugin for Blue Collar Crypto",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "kornrunner/keccak": "^1.1",
        "minishlink/web-push": "^9.0",
        "simplito/elliptic-php": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "BCC\\Trust\\Core\\": "app/Domain/Core/",
            "BCC\\Trust\\Disputes\\": "app/Domain/Disputes/",
            "BCC\\Trust\\Onchain\\": "app/Domain/Onchain/",
            "BCC\\Trust\\Infrastructure\\": "app/Infrastructure/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=4G",
        "test": "phpunit"
    }
}
